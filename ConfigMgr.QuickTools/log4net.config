<?xml version="1.0" encoding="utf-8" ?>
<!--
  Layer8 logging.
  Layer8 loads this file from the folder its DLLs live in and re-reads it when it changes, so you can
  switch on debug logging without restarting the console: change <level value="INFO" /> to DEBUG.
  The log is written in CMTrace format to %LOCALAPPDATA%\Layer8\Logs\Layer8.log (per user, so it
  works for console users who aren't local admins).
-->
<log4net>

  <!-- Also send everything to the debugger / DebugView. -->
  <appender name="TraceAppender" type="log4net.Appender.TraceAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="Layer8 %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="${LOCALAPPDATA}\Layer8\Logs\Layer8.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="2MB" />
    <maxSizeRollBackups value="3" />
    <staticLogFileName value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <converter>
        <name value="cmtype" />
        <type value="ConfigMgr.QuickTools.CMTrace.NumericLevelPatternConverter, ConfigMgr.QuickTools" />
      </converter>
      <converter>
        <name value="utcbias" />
        <type value="ConfigMgr.QuickTools.CMTrace.UTCOffsetPatternConverter, ConfigMgr.QuickTools" />
      </converter>
      <conversionPattern value="&lt;![LOG[%message%exception]LOG]!&gt;&lt;time=&quot;%date{HH:mm:ss.fff}%utcbias&quot; date=&quot;%date{MM-dd-yyyy}&quot; component=&quot;%logger&quot; context=&quot;&quot; type=&quot;%cmtype&quot; thread=&quot;%thread&quot; file=&quot;&quot;&gt;%newline" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="TraceAppender" />
    <appender-ref ref="RollingFileAppender" />
  </root>
</log4net>
