<?xml version="1.0" encoding="utf-8"?>
<!--
  The Layer8 installer.

  What it does:
    1. Finds the ConfigMgr console from the registry. No console, no install.
    2. Copies Layer8's DLLs (and the libraries they use) into the console's bin folder.
    3. Copies the menu (Actions) and dialog (Forms) XML into the console's XmlStorage\Extensions folder.
    4. Uninstalls cleanly, and a newer Layer8.msi replaces an older one in place (a "major upgrade").
       Uninstalling leaves the console's own (empty) Extensions\Actions and \Forms folders in place.

  Install it silently, the way MECM would:  msiexec /i Layer8.msi /qn
  An open console is asked to close (see CloseConsole below).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    UpgradeCode is Layer8's permanent identity. Every Layer8.msi ever built must keep this value; it's how
    Windows Installer knows a new MSI is an upgrade of an installed Layer8. Never change it.

    Version comes from Layer8.dll's file version (SharedAssemblyInfo.cs), so there's one place to bump it.
    Windows Installer only compares the first three parts (0.1.0), so bump at least the third number
    for each release.
  -->
  <Package Name="Layer8"
           Manufacturer="Layer8"
           Version="!(bind.FileVersion.Layer8.dll)"
           UpgradeCode="96752585-5D32-4B81-96E4-5999423295BC"
           Scope="perMachine">

    <!--
      Installing any Layer8.msi removes the installed one first, then installs the new files.
      AllowSameVersionUpgrades lets you reinstall a rebuilt MSI with the same version while developing.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Layer8 is already installed." />

    <!-- Everything goes inside the one .msi file. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs: Layer8's icon, and no "Change" button (there's nothing to change). -->
    <Icon Id="Layer8.ico" SourceFile="$(var.RepoDir)Layer8\Resources\tools.ico" />
    <Property Id="ARPPRODUCTICON" Value="Layer8.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Find the console. Its installer records its folder (...\AdminConsole\) in the 32-bit registry,
      HKLM\SOFTWARE\WOW6432Node\Microsoft\ConfigMgr10\Setup, value "UI Installation Directory".
    -->
    <Property Id="CONSOLEINSTALLDIR">
      <RegistrySearch Id="ConsoleInstallDir"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\ConfigMgr10\Setup"
                      Name="UI Installation Directory"
                      Type="raw"
                      Bitness="always32" />
    </Property>

    <!-- Stop with a clear message if there's no console. ("Installed" lets an uninstall through regardless.) -->
    <Launch Condition="Installed OR CONSOLEINSTALLDIR"
            Message="The Configuration Manager console isn't installed on this computer. Install the console, then run this again." />

    <!--
      The console locks Layer8's DLLs while it's open. Send it the same close message as clicking its X, so the
      files are replaced now instead of at the next restart. It never kills the console, and never prompts.
      A silent install running as SYSTEM (an MECM deployment) can't reach a signed-in user's console: then
      Windows Installer replaces the files at the next restart and returns 3010, which MECM treats as a
      soft reboot.
    -->
    <util:CloseApplication Id="CloseConsole"
                           Target="Microsoft.ConfigurationManagement.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Description="The Configuration Manager console is open and is being closed so Layer8 can be installed." />

    <!-- Point CONSOLEDIR at the folder found above, before Windows Installer works out where files go. -->
    <SetDirectory Id="CONSOLEDIR" Value="[CONSOLEINSTALLDIR]" />

    <!--
      The folder layout inside the console. CONSOLEDIR's name here is only a placeholder: SetDirectory
      above replaces the whole path with the console's real folder.
    -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="CONSOLEDIR" Name="ConfigMgrConsole">
        <Directory Id="CONSOLEBIN" Name="bin" />
        <Directory Id="XMLSTORAGE" Name="XmlStorage">
          <Directory Id="EXTENSIONSDIR" Name="Extensions">
            <Directory Id="EXTENSIONACTIONSDIR" Name="Actions" />
            <Directory Id="EXTENSIONFORMSDIR" Name="Forms" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!--
      Layer8's DLLs: all Layer8's own, so nothing here can clash with another console extension's files.
      "Layer8.dll" is named so the Version above can read its file version.
    -->
    <ComponentGroup Id="Layer8Binaries" Directory="CONSOLEBIN">
      <File Id="Layer8.dll" Source="$(var.BuildDir)Layer8.dll" />
      <File Source="$(var.BuildDir)Layer8.Device.dll" />
      <File Source="$(var.BuildDir)Layer8.DriverManager.dll" />
      <File Source="$(var.BuildDir)Layer8.IniFileParser.dll" />
    </ComponentGroup>

    <!--
      The console XML: everything under the repo's Extensions folder, keeping its folder structure
      (Actions\<console node GUID>\Layer8*.xml and Forms\*.xml).
    -->
    <ComponentGroup Id="ConsoleActions" Directory="EXTENSIONACTIONSDIR">
      <Files Include="$(var.ExtensionsDir)Actions\**" />
    </ComponentGroup>
    <ComponentGroup Id="ConsoleForms" Directory="EXTENSIONFORMSDIR">
      <Files Include="$(var.ExtensionsDir)Forms\**" />
    </ComponentGroup>

    <!--
      The console ships XmlStorage\Extensions\Actions and \Forms empty, and it only loads approved console
      extensions (the Layer8 cab, Community hub items) while Actions exists. Uninstalling a package can delete
      folders it leaves empty, including ones it didn't create (an earlier Layer8.msi removed both), and that
      quietly breaks every approved extension on the console. These two components are permanent: never
      removed, so neither are the folders.
    -->
    <ComponentGroup Id="KeepConsoleFolders">
      <Component Id="KeepConsoleActionsFolder" Directory="EXTENSIONACTIONSDIR" Guid="F61EB721-0413-4A7D-BF05-2F5EB304B5AA" Permanent="yes">
        <CreateFolder />
      </Component>
      <Component Id="KeepConsoleFormsFolder" Directory="EXTENSIONFORMSDIR" Guid="8E7B5300-698E-4B77-8AA1-01C50AFC7DC9" Permanent="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <Feature Id="Layer8">
      <ComponentGroupRef Id="Layer8Binaries" />
      <ComponentGroupRef Id="ConsoleActions" />
      <ComponentGroupRef Id="ConsoleForms" />
      <ComponentGroupRef Id="KeepConsoleFolders" />
    </Feature>
  </Package>
</Wix>
