<Project>
  <!--
    Fail early with a clear message instead of dozens of missing-reference errors when the console isn't installed.
    Only the Layer8 C# projects need the console; the INI parser and the installer don't.
  -->
  <Target Name="Layer8CheckConsole" BeforeTargets="ResolveAssemblyReferences" Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectName)' != 'INIFileParser'">
    <Error Condition="!Exists('$(ConfigMgrConsoleBin)Microsoft.ConfigurationManagement.exe')"
           Text="ConfigMgr console not found in '$(ConfigMgrConsoleBin)'. Install the ConfigMgr console, or build with -p:ConfigMgrConsoleBin=&lt;path to AdminConsole\bin&gt;." />
  </Target>

  <!--
    The security analyzers' results for each C# project (Directory.Build.props), as SARIF:
    Build\Analysis\<Configuration>\<project>.sarif. tools\Test-Layer8Regression.ps1 reads them. The folder is made
    before the compile, so the first build has somewhere to write.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Layer8AnalysisDir>$(MSBuildThisFileDirectory)Build\Analysis\$(Configuration)\</Layer8AnalysisDir>
    <ErrorLog>$(Layer8AnalysisDir)$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>
  <Target Name="Layer8AnalysisFolder" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <MakeDir Directories="$(Layer8AnalysisDir)" />
  </Target>
</Project>
